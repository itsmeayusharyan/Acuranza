    <!-- Left leg of the A: white fading to pale blue -->
    <path android:pathData="M54,26 L29,79" android:strokeWidth="10" android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:startX="54" android:startY="26" android:endX="29" android:endY="79" android:type="linear">
                <item android:color="#FFFFFFFF" android:offset="0"/>
                <item android:color="#FFC7D8F0" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Right leg: azure deepening to royal blue -->
    <path android:pathData="M54,26 L79,79" android:strokeWidth="10" android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient android:startX="54" android:startY="26" android:endX="79" android:endY="79" android:type="linear">

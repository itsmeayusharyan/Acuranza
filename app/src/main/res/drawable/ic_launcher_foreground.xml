                <item android:color="#FF38C6FF" android:offset="0"/>
                <item android:color="#FF1E8FFF" android:offset="1"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- Arrowhead pointing up-right -->
    <path android:pathData="M78,34 L73.4,49.2 L62.8,38.6 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:startX="78" android:startY="34" android:endX="66" android:endY="46" android:type="linear">
                <item android:color="#FF45CFFF" android:offset="0"/>
                <item android:color="#FF1E8FFF" android:offset="1"/>
            </gradient>
